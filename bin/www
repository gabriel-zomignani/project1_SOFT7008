#!/usr/bin/env node

// datetime-local form values represent Dublin time, including clock changes.
process.env.TZ = 'Europe/Dublin';

const http = require('http');
const app = require('../app');
const connectDatabase = require('../database');

const port = Number(process.env.PORT || 3000);

if (!Number.isInteger(port) || port < 1 || port > 65535) {
  console.error('PORT must be a whole number between 1 and 65535.');
  process.exit(1);
}

app.set('port', port);
const server = http.createServer(app);

server.on('error', function (error) {
  if (error.code === 'EADDRINUSE') {
    console.error('Port ' + port + ' is already in use. Stop the other server or set PORT.');
  } else if (error.code === 'EACCES') {
    console.error('Permission denied when listening on port ' + port + '.');
  } else {
    console.error(error);
  }
  process.exit(1);
});

server.on('listening', function () {
  console.log('Training Session Booking is running at http://localhost:' + port);
});

// Start accepting requests only after the database connection succeeds.
connectDatabase()
  .then(function () {
    console.log('Connected to MongoDB.');
    server.listen(port);
  })
  .catch(function () {
    console.error('Could not connect to MongoDB. The HTTP server was not started.');
    console.error('Check that MongoDB is running and MONGODB_URI is correct.');
    process.exit(1);
  });
