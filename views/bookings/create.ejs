<%- include('../partials/header') %>
  <h1><%= title %></h1>
  <p>Enter the person's details and the session date and time. All fields are required.</p>
  <p>This project does not accept card details or process payments yet.</p>

  <% if (errors.length > 0) { %>
    <div class="form-errors" role="alert">
      <h2>Check your booking</h2>
      <ul>
        <% errors.forEach(function (error) { %>
          <li><%= error %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form action="/bookings/create" method="post" class="booking-form">
    <div class="form-field">
      <label for="personName">Person name</label>
      <input type="text" id="personName" name="personName" value="<%= values.personName %>" required>
    </div>

    <div class="form-field">
      <label for="personId">Person ID</label>
      <p id="person-id-hint" class="field-hint">Exactly 10 characters. Letters and numbers are allowed.</p>
      <input type="text" id="personId" name="personId" value="<%= values.personId %>"
        minlength="10" maxlength="10" aria-describedby="person-id-hint" required>
    </div>

    <div class="form-field">
      <label for="sessionDateTime">Session date and time (Dublin)</label>
      <p id="session-time-hint" class="field-hint">Use Europe/Dublin time, even if you are elsewhere.
        At the autumn clock change, a repeated time means its first occurrence.
        Times skipped at the spring clock change are not valid.</p>
      <input type="datetime-local" id="sessionDateTime" name="sessionDateTime"
        value="<%= values.sessionDateTime %>" step="60" aria-describedby="session-time-hint" required>
    </div>

    <button type="submit">Save booking</button>
  </form>
  <p><a href="/bookings">View existing bookings</a></p>
<%- include('../partials/footer') %>
