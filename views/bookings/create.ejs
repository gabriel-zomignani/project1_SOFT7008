<%- include('../partials/header') %>
  <h1><%= title %></h1>
  <p>Enter the person's details and the session date and time. All fields are required.</p>
  <p class="notice">Demo only. Use the sample card details shown below. No payment is taken.</p>

  <% if (errors.length > 0) { %>
    <div class="form-errors" role="alert">
      <h2>Check your booking</h2>
      <ul>
        <% errors.forEach(function (error) { %>
          <li><%= error %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form action="/bookings/create" method="post" class="booking-form">
    <div class="form-field">
      <label for="personName">Person name</label>
      <input type="text" id="personName" name="personName" value="<%= values.personName %>" required>
    </div>

    <div class="form-field">
      <label for="personId">Person ID</label>
      <p id="person-id-hint" class="field-hint">Exactly 10 characters. Letters and numbers are allowed.</p>
      <input type="text" id="personId" name="personId" value="<%= values.personId %>"
        minlength="10" maxlength="10" aria-describedby="person-id-hint" required>
    </div>

    <div class="form-field">
      <label for="sessionDateTime">Session date and time (Dublin)</label>
      <p id="session-time-hint" class="field-hint">Use Europe/Dublin time.
        See <a href="/help">Help</a> for clock-change details.</p>
      <input type="datetime-local" id="sessionDateTime" name="sessionDateTime"
        value="<%= values.sessionDateTime %>" step="60" aria-describedby="session-time-hint" required>
    </div>

    <fieldset class="demo-card-fields">
      <legend>Demo card details</legend>
      <div class="form-field">
        <label for="demoCardNumber">Demo card number</label>
        <p id="demo-card-number-hint" class="field-hint">Use the sample number: <strong>4111111111111111</strong>.</p>
        <input type="text" id="demoCardNumber" name="demoCardNumber" autocomplete="off"
          aria-describedby="demo-card-number-hint" required>
      </div>

      <div class="form-field">
        <label for="demoCardExpiry">Demo expiry</label>
        <p id="demo-card-expiry-hint" class="field-hint">Use the sample expiry: <strong>12/2030</strong>.</p>
        <input type="text" id="demoCardExpiry" name="demoCardExpiry" autocomplete="off"
          aria-describedby="demo-card-expiry-hint" required>
      </div>

      <div class="form-field">
        <label for="demoSecurityCode">Demo security code</label>
        <p id="demo-security-code-hint" class="field-hint">Use the sample code: <strong>123</strong>.
          This is checked but not stored.</p>
        <input type="password" id="demoSecurityCode" name="demoSecurityCode" autocomplete="off"
          aria-describedby="demo-security-code-hint" required>
      </div>
    </fieldset>

    <button type="submit">Save booking</button>
  </form>
  <p><a href="/bookings">View existing bookings</a></p>
<%- include('../partials/footer') %>
